target/
*.class
*.log

# Runtime H2 database files created when actually running the service
url-shortener/data/
data/
*.mv.db
*.trace.db

# Orchestrator run output is generated fresh on every execution; a curated snapshot is
# committed separately under orchestrator/sample-runs/ as evidence.
orchestrator/runs/

# The blanket *.log rule above would otherwise silently swallow the real mvn-test-output
# evidence files inside the committed sample-runs snapshot - un-ignore those specifically.
!orchestrator/sample-runs/**/*.log

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db
